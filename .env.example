# Database — PostgreSQL (required). Local: docker compose up -d (see docs/POSTGRES.md)
DATABASE_URL="postgresql://qiktik:qiktik@localhost:5432/qiktik?schema=public"

# Default venue slug when ?venue= is omitted (local single-venue demos)
DEFAULT_VENUE_SLUG="my-restaurant"
NEXT_PUBLIC_DEFAULT_VENUE_SLUG="my-restaurant"

# Edge server mode: "cloud" | "edge"
DEPLOYMENT_MODE="cloud"
EDGE_SERVER_URL="http://192.168.1.50:4000"
CLOUD_SYNC_URL="https://api.yourvenue.com"

# Stripe (card payments — online only)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Venue display (demo)
NEXT_PUBLIC_VENUE_NAME="My Restaurant"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
# Public base for guest QR/NFC when admin is opened on localhost.
# Non-localhost Host (LAN IP or Cloudflare tunnel) wins over this for QR links.
# NEXT_PUBLIC_MENU_BASE_URL="http://10.0.0.35:3000"
# Demo / default table token for guest “Digital menu” links from pickup
# NEXT_PUBLIC_DEMO_TABLE_TOKEN="t_table7demo2026"

# Staff gate (/admin, /pickup, /kitchen, /waiter) — demo password default: qiktik2026
# STAFF_DEMO_PASSWORD="qiktik2026"
# STAFF_COOKIE_SECURE="true"   # only for HTTPS; leave unset for http://LAN demos

# Auto-translate menu names/descriptions into ar/he/en/ru when creating/editing
# AUTO_TRANSLATE="false"   # set to disable
# MYMEMORY_EMAIL="you@example.com"  # optional, higher free quota

# Real-time
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# Web Push (guest pickup — alerts when the waiting tab is backgrounded / closed)
# Required for background push. Without these, guests still get in-page Notification + SSE.
# Generate keys:
#   npx web-push generate-vapid-keys
# Copy the public key to NEXT_PUBLIC_VAPID_PUBLIC_KEY and the private key to VAPID_PRIVATE_KEY.
# VAPID_SUBJECT must be a mailto: or https: contact URI (Web Push spec).
# Apple rejects mailto:…@*.local with 403 BadJwtToken — use a normal domain (e.g. mailto:push@qiktik.app).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B…"
# VAPID_PRIVATE_KEY="…"
# VAPID_SUBJECT="mailto:push@qiktik.app"
#
# Notes:
# - HTTPS (or localhost) required for service workers / push.
# - LAN http://10.0.0.x on iPhone cannot register SW/push — use a free tunnel (see docs/IOS_PUSH.md).
# - iOS: Web Push only in Home Screen / standalone PWA (iOS 16.4+). Safari background tabs do NOT get push.
# - Hint: npm run dev:tunnel-hint
